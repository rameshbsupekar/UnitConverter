<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
	<!-- Add the official NuGet v3 feed so Visual Studio and dotnet restore can find packages -->
	<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
	<!-- Keep the default Visual Studio offline source if present (optional) -->
	<add key="Visual Studio Offline Packages" value="%ProgramFiles(x86)%\Microsoft SDKs\NuGetPackages\" />
  </packageSources>
</configuration>
