{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Polly": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Services": {
    "Catalog": {
      "Url": "https://localhost:7001"
    },
    "Conversion": {
      "Url": "https://localhost:7002"
    }
  },
  "RateLimiting": {
    "Policies": {
      "FixedWindow_ByIp": {
        "PermitLimit": 10,
        "QueueLimit": 5
      },
      "SlidingWindow_ByUser": {
        "PermitLimit": 100,
        "QueueLimit": 10
      },
      "TokenBucket_ByApiKey": {
        "TokenLimit": 500,
        "QueueLimit": 0
      }
    }
  }
}
