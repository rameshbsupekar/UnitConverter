# Manual tests: MANUAL-TESTING.md (repo root)
# HTTPS (F5 default). HTTP: change host to http://localhost:5180

@host = https://localhost:7180
@v1 = {{host}}/api/v1

# Seeded users (password Test@12345):
# admin@unitconverter.local | employee@unitconverter.local | partner@unitconverter.local | public@unitconverter.local

### Sign in (Content-Type only; copy accessToken for Units .http @token)
# @name login
POST {{v1}}/sessions
Content-Type: application/json

{
  "email": "admin@unitconverter.local",
  "password": "Test@12345"
}

### Sign in as Employee
POST {{v1}}/sessions
Content-Type: application/json

{
  "email": "employee@unitconverter.local",
  "password": "Test@12345"
}

### Refresh access token (Content-Type only)
POST {{v1}}/sessions/refresh
Content-Type: application/json

{
  "refreshToken": "<paste-refresh-token-from-login>"
}

### Register new user (Content-Type only)
POST {{v1}}/users
Content-Type: application/json

{
  "email": "newuser@example.com",
  "password": "TestUser@12345",
  "firstName": "Ramesh",
  "lastName": "Supekar",
  "organizationName": "TestOrg",
  "idempotencyKey": "1af9f554-bc99-4960-a2a0-5e6b8fa703ad"
}

### Health (no headers)
GET {{host}}/health
