# Manual tests: docs/MANUAL-TESTING.md
# HTTPS (F5 default). HTTP: change host to http://localhost:5173

@host = https://localhost:7100
@v1 = {{host}}/api/v1
@authHost = https://localhost:7180
@auth = {{authHost}}/api/v1

# UnitCategory: Length=1, Mass=2, Temperature=3

### Convert length: 1000 m → km (Content-Type only)
POST {{v1}}/unit-conversions
Content-Type: application/json

{
  "value": 1000,
  "fromUnit": "m",
  "toUnit": "km",
  "category": 1
}

### Convert temperature: 0 °C → °F (Content-Type only)
POST {{v1}}/unit-conversions
Content-Type: application/json

{
  "value": 0,
  "fromUnit": "c",
  "toUnit": "f",
  "category": 3
}

### Convert mass: 1 kg → lb (Content-Type only)
POST {{v1}}/unit-conversions
Content-Type: application/json

{
  "value": 1,
  "fromUnit": "kg",
  "toUnit": "lb",
  "category": 2
}

### Public catalog: list categories (no headers)
GET {{v1}}/catalog/categories

### Public catalog: length units by category id
GET {{v1}}/catalog/units?category=1&page=1&pageSize=20

### Public catalog: length units by name
GET {{v1}}/catalog/units?categoryName=length&page=1&pageSize=20

### Public catalog: mass units
GET {{v1}}/catalog/units?categoryName=mass&page=1&pageSize=20

# --- Unit definitions: sign in on 7180 first, paste accessToken below ---
@token = <paste-accessToken-from-sessions>

### Sign in as Admin (run on auth host; Content-Type only)
# @name login
POST {{auth}}/sessions
Content-Type: application/json

{
  "email": "admin@unitconverter.local",
  "password": "Test@12345"
}

### Unit definitions: list (Authorization)
GET {{v1}}/unit-definitions?page=1&pageSize=50
Authorization: Bearer {{token}}

### Unit definitions: create (Authorization + Content-Type)
POST {{v1}}/unit-definitions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "symbol": "mi",
  "displayName": "Mile",
  "category": 1,
  "multiplierToBase": 1609.344,
  "offsetToBase": 0
}

### Unit definitions: get by id (Authorization; replace id)
GET {{v1}}/unit-definitions/1
Authorization: Bearer {{token}}

### Unit definitions: update (Authorization + Content-Type; replace id)
PUT {{v1}}/unit-definitions/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "displayName": "Meter",
  "multiplierToBase": 1,
  "offsetToBase": 0
}

### Unit definitions: approve (Authorization; Admin; replace id)
PUT {{v1}}/unit-definitions/1/approve
Authorization: Bearer {{token}}

### Unit definitions: admin correction (Authorization + Content-Type; Admin; replace id)
PUT {{v1}}/unit-definitions/1/admin-correction
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "displayName": "Meter (verified)",
  "multiplierToBase": 1,
  "offsetToBase": 0
}

### Unit definitions: delete (Authorization; Admin; replace id)
DELETE {{v1}}/unit-definitions/99
Authorization: Bearer {{token}}

### OpenAPI document (Development; no headers)
GET {{host}}/openapi/v1.json
